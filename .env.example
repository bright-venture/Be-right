# ── Supabase (Project Settings → API) ──────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret / service_role key — server only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Private buckets (created automatically on first upload): customer photos/videos, technician documents.
SUPABASE_STORAGE_BUCKET=request-media
SUPABASE_DOCS_BUCKET=technician-docs

# ── Database (Project Settings → Database → Connection string) ─────
# Runtime: transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Migrations: session pooler or direct connection (port 5432)
DIRECT_DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Roles ───────────────────────────────────────────────────────────
# Comma-separated emails of the owners: they become admins (/admin) when they sign in.
# Admins add the rest of the team (specialists, other admins) from /admin → Team.
OWNER_EMAILS=
# Comma-separated emails that become specialists (office staff) when they sign in.
SPECIALIST_EMAILS=

# ── Notification emails (Resend → API Keys; "Sending access" is enough) ──
# Without a key, notifications are skipped (sign-in emails still go through Supabase).
RESEND_API_KEY=
# Optional: sender, where replies go, and the site address used in email links.
EMAIL_FROM=Be Right <noreply@be-rightbright.com>
EMAIL_REPLY_TO=hello@be-rightbright.com
SITE_URL=https://be-rightbright.com

# ── Frontend (exposed to the browser at build time) ─────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable / anon key (safe for the browser; all tables have RLS enabled).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to "true" after enabling the Google provider in Supabase Auth.
VITE_AUTH_GOOGLE=false
# Optional: Cloudflare Web Analytics token (Cloudflare → Analytics & Logs → Web Analytics → Add a site).
VITE_CF_ANALYTICS_TOKEN=
# Optional: MapTiler key for map images (cloud.maptiler.com → API keys); OpenStreetMap is used without it.
VITE_MAPTILER_KEY=
