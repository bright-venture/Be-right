{
  "name": "be-right",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild server/boot.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "build:netlify": "vite build && node scripts/build-netlify.mjs",
    "cleanup:documents": "esbuild server/jobs/cli.ts --bundle --platform=node --format=esm --outfile=dist/cleanup.mjs --log-level=warning --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\" && node dist/cleanup.mjs",
    "app:sync": "vite build && cap sync",
    "app:android": "npm run app:sync && cap open android"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.2.26",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@hono/node-server": "^2.1.4",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "6.12.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.1",
    "@hono/vite-dev-server": "^0.19.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.12"
  },
  "overrides": {
    "@hono/node-server": "$@hono/node-server",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "postcss-selector-parser": "^7.1.6",
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
